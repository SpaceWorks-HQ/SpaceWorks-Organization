    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.19.0",
    "puppeteer": "^24.38.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
